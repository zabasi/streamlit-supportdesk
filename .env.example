# Copy to .env and fill in. `supportdesk` reads ./.env automatically; variables already set win.
OPENAI_API_KEY=
OPENAI_BASE_URL=            # the Metis gateway URL, from your Metis account
# SUPPORTDESK__RUN__MODE=live      # any setting can go here as SUPPORTDESK__SECTION__KEY=value
# Live spending on this machine stops at this many US dollars (all runs together).
SUPPORTDESK__BUDGET__CEILING_USD=0.8
