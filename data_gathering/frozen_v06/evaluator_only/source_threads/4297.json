    "title": "User's session_state is reset on websocket close",
    "html_url": "https://github.com/streamlit/streamlit/issues/4297",
    "created_at": "2022-01-19T08:41:33Z",
    "updated_at": "2023-01-24T07:10:06Z",
    "closed_at": "2023-01-24T00:06:33Z",
